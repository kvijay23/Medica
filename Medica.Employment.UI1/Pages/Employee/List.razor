
@page "/employee/list"
@inject Services.Contracts.IEmployeeService EmployeeService
@using Medica.Employment.Domain.Entities
@inject HttpClient Http
@inject NavigationManager Navigation
<script src="js/site.js"></script>
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Employee List</h3>
        <button class="btn btn-light" @onclick="AddEmployee">Add Employee</button>
    </div>
    <div class="card-body">
        @if (employees == null)
        {
            <p>Loading employees...</p>
        }
        else if (!employees.Any())
        {
            <p>No employees found.</p>
        }
        else
        {
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Job Title</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in employees)
                    {
                        <tr>
                            <td>@employee.FirstName @employee.LastName</td>
                            <td>@employee.Email</td>
                            <td>@employee.JobTitle</td>
                            <td>
                                <button class="btn btn-primary btn-sm me-2" @onclick="() => EditEmployee(employee.Id)">Edit</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDelete(employee.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<Employee> employees;
    [Inject]
    private IJSRuntime JS { get; set; } // Inject IJSRuntime for JS calls
    protected override async Task OnInitializedAsync()
    {
        employees = await EmployeeService.GetEmployeesAsync();
    }

    private void AddEmployee()
    {
        Navigation.NavigateTo("employee/add");
    }

    private void EditEmployee(int id)
    {
       // Navigation.NavigateTo($"/employee-form/{id}");
    }

    private async Task DeleteEmployee(int id)
    {
        try
        {
            // Call the DeleteEmployee method from the service
            await EmployeeService.DeleteEmployee(id);

            // Refresh the employee list after deletion
            employees = await EmployeeService.GetEmployeesAsync();
        }
        catch (Exception ex)
        {
            // Handle any errors that might occur during deletion
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task ConfirmDelete(int id)
    {
        var confirmResult = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this employee?");
        if (confirmResult)
        {
            await DeleteEmployee(id);
        }
    }

   
}

